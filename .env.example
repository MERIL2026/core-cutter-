# Sarvam AI Multilingual Voice Suite (Server-Side Only - Indian STT & Bulbul v3 TTS)
# Supports: English (en-IN), Hindi (hi-IN), Gujarati (gu-IN), Hinglish, Gujlish
# Get your API key at https://www.sarvam.ai/
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v2"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="priya"

# Google Gemini API Key (Server-Side Only - for Multilingual AI Chatbot)
GEMINI_API_KEY=""

# ElevenLabs Studio AI Voice API Key (Optional secondary TTS provider)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# Supabase Database & Client (Recommended Cloud Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# EmailJS Automatic Lead Email Notifications (https://www.emailjs.com/)
# Service ID from EmailJS -> Email Services
EMAILJS_SERVICE_ID="service_xxxxxxx"
# Template ID from EmailJS -> Email Templates
EMAILJS_TEMPLATE_ID="template_xxxxxxx"
# Public Key from EmailJS -> Account -> API Keys
EMAILJS_PUBLIC_KEY="your_public_key"
# Private Key / Access Token from EmailJS (Optional, if strict mode enabled)
EMAILJS_PRIVATE_KEY=""
# Target Email where lead notifications should arrive
EMAILJS_TO_EMAIL="technician@yourdomain.com"

# Application Public Environment Variables
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_PHONE="+919876543210"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
